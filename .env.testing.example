# Copy to .env.testing only if your local workflow needs a file-based template.
# Never commit a real password. Prefer exporting these variables from a secret manager.
APP_ENV=testing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spmb_testing
DB_USERNAME=spmb_testing_user
# SPMB_TEST_DB_PASSWORD must be supplied by the process environment or secret manager.

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
